{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts"
  ]
}